{
  "E01": "${{ format('{0}-{1}-{0}', 'a', 'b') }}",
  "E02": "${{ format('{{literal}} {0}', 'x') }}",
  "E03": "${{ join(fromJSON('[\"a\",\"b\",\"c\"]'), '+') }}",
  "E04": "${{ toJSON(fromJSON('{\"a\":[1,2],\"b\":null}')) }}",
  "E05": "${{ toJSON(fromJSON('{\"items\":[{\"name\":\"x\"},{\"name\":\"y\"}]}').items.*.name) }}",
  "E06": "${{ join(fromJSON('{\"items\":[{\"name\":\"x\"},{\"name\":\"y\"}]}').items.*.name, ',') }}",
  "E07": "${{ contains('Hello World', 'WORLD') }}",
  "E08": "${{ contains(fromJSON('[\"a\",\"B\"]'), 'b') }}",
  "E09": "${{ startsWith('Refs/Heads/main', 'refs/') }}",
  "E10": "${{ endsWith('file.YAML', '.yaml') }}",
  "E11": "${{ '1' == 1 }}",
  "E12": "${{ null == 0 }}",
  "E13": "${{ '' == false }}",
  "E14": "${{ 'abc' == 'ABC' }}",
  "E15": "${{ 0x10 == 16 }}",
  "E16": "${{ 1e3 == 1000 }}",
  "E17": "${{ 'a' < 'B' }}",
  "E18": "${{ null || 'fallback' }}",
  "E19": "${{ 'first' && 'second' }}",
  "E20": "${{ '' || 0 || 'last' }}",
  "E21": "${{ !'' }}",
  "E22": "${{ !(1 == 2) }}",
  "E23": "${{ (1 < 2) == true }}",
  "E24": "${{ 1 < 2 == true }}",
  "E25": "${{ fromJSON('[1,2,3]')[1] }}",
  "E26": "${{ fromJSON('{\"a\":{\"b\":\"deep\"}}')['a'].b }}",
  "E27": "${{ env.FOO }}",
  "E28": "${{ format('{0}', env.MISSING) }}",
  "E29": "${{ toJSON(env.MISSING) }}",
  "E30": "${{ 'it''s' }}",
  "E31": "${{ format('{0} {1}', true, 1.50) }}",
  "E32": "${{ 1.0 == 1 }}",
  "E33": "${{ fromJSON('1.0') }}",
  "E34": "${{ toJSON(true) }}",
  "E35": "${{ hashFiles('sub/*', 'pnpm-lock.yaml') }}",
  "E36": "${{ hashFiles('does-not-exist/*') }}",
  "E37": "pre-${{ format('{0}', 'x') }}-mid-${{ 1 == 1 }}-post",
  "E38": "${{ contains(toJSON(fromJSON('{\"k\":\"v\"}')), '\"k\"') }}",
  "E39": "${{ fromJSON('[]')[5] }}",
  "E40": "${{ format('{0}', fromJSON('{\"a\":1}')) }}"
}